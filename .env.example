APP_NAME="DogeOW Chat API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8013
FRONTEND_URL=http://localhost:3013

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Chat API 只有这一条 SQL 连接；中央账号通过短期 SSO 票据同步到 chat_users。
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chat
DB_USERNAME=chat
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=chat_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_LIMITER=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=chat
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=11
REDIS_CACHE_DB=12
REDIS_SESSION_DB=13
REDIS_PREFIX=chat:

IDENTITY_API_URL=http://127.0.0.1
IDENTITY_SSO_CLIENT_SECRET=

REVERB_APP_ID=chat
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8083
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8083

MAIL_MAILER=log
MAIL_FROM_ADDRESS="chat@dogeow.com"
MAIL_FROM_NAME="${APP_NAME}"
